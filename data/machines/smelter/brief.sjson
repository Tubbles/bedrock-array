// The smelter's brief (doc/workflows/art_book.md, Files): the data every step of D4 reads.
// 1 by 1 cells of a metre, 1 m tall (user, 2026-10-18): the study's box (doc/techtonica.md, Footprints and heights) read massive on the entry pages, and Techtonica's machines stand no taller than the player.
// The front faces +z; y is up; positions are metres from the footprint's bottom centre. A part's blockout is one shape or a list of shapes.
id = "smelter"
family = "furnace"
role = "melts ore into ingots"
footprint = {
	cells = [1, 1]
	clearance = 1
	cell_metres = 1
}
height_metres = 1.0
figure_metres = 1.8
silhouette = "a squat drum on a low base, a domed copper lid, a short stack at the back"
feature = "a glowing grille window as the face on the front"
entry = "without chutes, in a cave lit by its own hearth and the glowing flora, shown working, in slate blue painted panels with copper fittings"
parts = [
	{ name = "base" material = "bare_alloy" role = "base" blockout = { shape = "box" size = [2.0, 0.25, 2.0] position = [0, 0.125, 0] } }
	{ name = "body" material = "painted_steel" role = "shell" blockout = { shape = "cylinder" radius = 0.9 height = 1.25 position = [0, 0.875, 0] } }
	{ name = "lid" material = "copper" role = "lid" blockout = { shape = "dome" radius = 0.95 height = 0.3 position = [0, 1.5, 0] } }
	{ name = "stack" material = "bare_alloy" role = "stack" blockout = { shape = "cylinder" radius = 0.12 height = 0.45 position = [0, 1.775, -0.6] } }
	{ name = "window" material = "furnace_glow" role = "emissive" blockout = { shape = "box" size = [0.6, 0.3, 0.1] position = [0, 1.0, 0.87] } }
	{ name = "grille" material = "bare_alloy" role = "grille" blockout = [ { shape = "box" size = [0.7, 0.03, 0.03] position = [0, 0.9, 0.95] } { shape = "box" size = [0.7, 0.03, 0.03] position = [0, 1.0, 0.95] } { shape = "box" size = [0.7, 0.03, 0.03] position = [0, 1.1, 0.95] } ] }
]
cues = [
	{ name = "working" behaviour = "the window glows orange with heat and flickers, a shimmer over the lid" parts = ["window"] sockets = ["heat"] }
	{ name = "smoking" behaviour = "thin smoke from the stack while processing" sockets = ["stack_top"] }
	{ name = "venting" behaviour = "the lid lifts on its rear hinge to vent between batches" parts = ["lid"] pivot = { part = "lid" axis = "rear_top_edge" range_degrees = [0, 25] } }
]
budget = {
	triangles = 12000
}
art = {
	model = "banana"
	seeds = []
}
