// The smelter's brief (doc/workflows/art_book.md, Files): the data every step of D4 reads.
// Read off the chosen entry, data/art/smelter/entry.png (entry round 8 seed 11, user 2026-10-18), without its pipes and stack: a 1x1x1 m cube on a low skirt, the hearth mouth on the front.
// The front faces +z; y is up; positions are metres from the footprint's bottom centre. A part's blockout is one shape or a list of shapes.
id = "smelter"
family = "furnace"
role = "melts ore into ingots"
footprint = {
	cells = [1, 1]
	clearance = 1
	cell_metres = 1
}
height_metres = 1.0
figure_metres = 1.8
silhouette = "a cube on a low skirt, a flat raised lid plate, nothing rising above the box"
feature = "a copper framed hearth mouth glowing on the front over a copper sill"
entry = "without chutes, in a cave lit by its own hearth and the glowing flora, shown working, in slate blue painted panels with copper fittings"
parts = [
	{ name = "skirt" material = "painted_steel" role = "base" blockout = { shape = "box" size = [1.0, 0.4, 1.0] position = [0, 0.2, 0] } }
	{ name = "body" material = "painted_steel" role = "shell" blockout = { shape = "box" size = [0.9, 0.5, 0.9] position = [0, 0.65, 0] } }
	{ name = "lid" material = "painted_steel" role = "lid" blockout = { shape = "box" size = [0.55, 0.1, 0.55] position = [0, 0.95, 0] } }
	{ name = "hearth_frame" material = "copper" role = "frame" blockout = { shape = "box" size = [0.5, 0.5, 0.08] position = [0, 0.5, 0.49] } }
	{ name = "hearth" material = "furnace_glow" role = "emissive" blockout = { shape = "box" size = [0.36, 0.36, 0.1] position = [0, 0.52, 0.49] } }
	{ name = "sill" material = "copper" role = "sill" blockout = { shape = "box" size = [0.5, 0.05, 0.12] position = [0, 0.24, 0.53] } }
	{ name = "vents" material = "bare_alloy" role = "grille" blockout = [ { shape = "box" size = [0.04, 0.12, 0.03] position = [-0.08, 0.1, 0.51] } { shape = "box" size = [0.04, 0.12, 0.03] position = [0, 0.1, 0.51] } { shape = "box" size = [0.04, 0.12, 0.03] position = [0.08, 0.1, 0.51] } ] }
	{ name = "louvre" material = "bare_alloy" role = "grille" blockout = [ { shape = "box" size = [0.03, 0.03, 0.2] position = [-0.46, 0.75, 0.2] } { shape = "box" size = [0.03, 0.03, 0.2] position = [-0.46, 0.8, 0.2] } { shape = "box" size = [0.03, 0.03, 0.2] position = [-0.46, 0.85, 0.2] } ] }
]
cues = [
	{ name = "working" behaviour = "the hearth mouth glows orange with heat and flickers, a shimmer over the lid" parts = ["hearth"] sockets = ["heat"] }
	{ name = "venting" behaviour = "the lid plate lifts on its rear hinge to vent between batches" parts = ["lid"] pivot = { part = "lid" axis = "rear_top_edge" range_degrees = [0, 25] } }
]
budget = {
	triangles = 12000
}
art = {
	model = "banana"
	seeds = []
}
