// The smelter's brief (doc/workflows/art_book.md, Files): the data every step of D4 reads.
// Sizes are provisional until the Techtonica study (item 0039) lands its numbers.
// The front faces +z; y is up; positions are metres from the footprint's bottom centre.
id = "smelter"
family = "furnace"
role = "melts ore into ingots"
footprint = {
	cells = [2, 2]
	blocked = [4, 4]
	cell_metres = 1
}
height_metres = 2.8
figure_metres = 1.8
silhouette = "a squat drum on a low base, a domed copper lid, a short stack at the back"
feature = "a glowing grille window as the face on the front"
parts = [
	{ name = "base" material = "bare_alloy" role = "base" blockout = { shape = "box" size = [2.0, 0.3, 2.0] position = [0, 0.15, 0] } }
	{ name = "body" material = "painted_steel" role = "shell" blockout = { shape = "cylinder" radius = 0.85 height = 1.6 position = [0, 1.1, 0] } }
	{ name = "lid" material = "copper" role = "lid" blockout = { shape = "dome" radius = 0.9 height = 0.35 position = [0, 1.9, 0] } }
	{ name = "stack" material = "bare_alloy" role = "stack" blockout = { shape = "cylinder" radius = 0.15 height = 0.7 position = [0, 2.45, -0.55] } }
	{ name = "window" material = "furnace_glow" role = "emissive" blockout = { shape = "box" size = [0.6, 0.35, 0.1] position = [0, 1.0, 0.82] } }
	{ name = "grille" material = "bare_alloy" role = "grille" blockout = { shape = "box" size = [0.7, 0.45, 0.04] position = [0, 1.0, 0.88] } }
]
cues = [
	{ name = "working" behaviour = "the window glows orange with heat and flickers, a shimmer over the lid" parts = ["window"] sockets = ["heat"] }
	{ name = "smoking" behaviour = "thin smoke from the stack while processing" sockets = ["stack_top"] }
	{ name = "venting" behaviour = "the lid lifts on its rear hinge to vent between batches" parts = ["lid"] pivot = { part = "lid" axis = "rear_top_edge" range_degrees = [0, 25] } }
]
budget = {
	triangles = 12000
}
art = {
	model = "banana"
	seeds = []
}
