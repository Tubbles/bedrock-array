// One style paragraph per machine family, composed into every prompt of the family, and its palette for the review sheet (doc/workflows/art_book.md).
// The look is DESIGN.md's stylised realism: real light on real materials, simplified shapes, no outlines, no toy palette.
// The furnace paragraph and palette are read off the smelter's chosen entry, data/art/smelter/entry.png (user, 2026-10-18): slate blue panels, copper, moss, the hearth glow.
furnace = {
	style = "Concept art of an industrial machine for a factory game, stylised realism: real light on real materials, simplified shapes, low texture detail, no outlines, no cartoon palette. A compact cube of slate blue painted panels on a low skirt, the paint chipped at the edges to the metal, grime in the seams, moss taking hold in the cool corners, small bolts and panel seams, a copper framed hearth mouth glowing on the front, a flat raised lid plate on top, no pipes, no stack. Clean concept presentation on a neutral ground, an astronaut figure beside it for scale, no text, no logos."
	palette = [[0.40, 0.50, 0.57], [0.62, 0.46, 0.35], [0.28, 0.34, 0.28], [0.92, 0.64, 0.39]]
}
