// The parts demo: the smelter's full generated model split into its brief's parts by tools/models/parts.py (data/machines/smelter/generated.sjson), each part in the material the brief names, orbited. The second and third configurations are each part decimated to its share of 192000 triangles (tools/models/finish_parts.sh), the larger parts closed by Poisson first and trimmed to 1 cm or to 3 mm of their own surface, the vents, louvre and fittings decimated only (the closing in generated.sjson). The sill has no blob, the generator merged it into the hearth frame.
camera = { mode = "orbit", target = [0, 0.5, 0], yaw = 0.5, pitch = 0.3, distance = 2.5 }
sun = { direction = [0.4, -1, -0.3], colour = [1, 0.96, 0.9], intensity = 1 }
exposure = 1
ambient = 0.15
configurations = ["as generated", "closed, 1 cm trim", "closed, 3 mm trim"]
items = [
	{ shape = "box", size = [3, 0.1, 3], position = [0, -0.05, 0], material = "concrete" }
	{ shape = "mesh", files = ["skirt.mesh", "skirt_192000_trim10.mesh", "skirt_192000_trim3.mesh"], scale = 1, position = [0, 0, 0], material = "painted_steel" }
	{ shape = "mesh", files = ["body.mesh", "body_192000_trim10.mesh", "body_192000_trim3.mesh"], scale = 1, position = [0, 0, 0], material = "painted_steel" }
	{ shape = "mesh", files = ["lid.mesh", "lid_192000_trim10.mesh", "lid_192000_trim3.mesh"], scale = 1, position = [0, 0, 0], material = "painted_steel" }
	{ shape = "mesh", files = ["hearth_frame.mesh", "hearth_frame_192000_trim10.mesh", "hearth_frame_192000_trim3.mesh"], scale = 1, position = [0, 0, 0], material = "copper" }
	{ shape = "mesh", files = ["hearth.mesh", "hearth_192000_trim10.mesh", "hearth_192000_trim3.mesh"], scale = 1, position = [0, 0, 0], material = "furnace_glow" }
	{ shape = "mesh", files = ["vents.mesh", "vents_192000_trim10.mesh", "vents_192000_trim3.mesh"], scale = 1, position = [0, 0, 0], material = "bare_alloy" }
	{ shape = "mesh", files = ["louvre.mesh", "louvre_192000_trim10.mesh", "louvre_192000_trim3.mesh"], scale = 1, position = [0, 0, 0], material = "bare_alloy" }
	{ shape = "mesh", files = ["fittings.mesh", "fittings_192000_trim10.mesh", "fittings_192000_trim3.mesh"], scale = 1, position = [0, 0, 0], material = "copper" }
]
