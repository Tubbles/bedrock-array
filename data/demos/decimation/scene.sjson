// The decimation demo: the full model as the reference, then Blender's decimations of its Poisson closing (tools/models/reconstruct.py with --depth, then decimate.py) from 768000 triangles down to 12000, halving each step, in a row from the left. The camera orbits one furnace at a time and the arrows step to the next. The configurations are the Poisson depth of the closing the levels come from. A closing with no more triangles than a level (depth 8 has 587410, depth 7 142020, depth 6 33726) stands in for it undecimated, so the plaque counts hold only where the closing had more.
camera = { mode = "orbit", target = [-5.6, 0.5, 0], yaw = 0, pitch = 0.35, distance = 2.5 }
sun = { direction = [0.4, -1, -0.3], colour = [1, 0.96, 0.9], intensity = 1 }
exposure = 1
ambient = 0.15
configurations = ["Poisson depth 9", "Poisson depth 8", "Poisson depth 7", "Poisson depth 6"]
items = [
	{ shape = "box", size = [14, 0.1, 3], position = [0, -0.05, 0], material = "concrete" }
	{ shape = "mesh", file = "full.mesh", scale = 1, position = [-5.6, 0, 0], material = "painted_steel" }
	{ shape = "mesh", files = ["poisson_768000.mesh", "poisson_depth8.mesh", "poisson_depth7.mesh", "poisson_depth6.mesh"], scale = 1, position = [-4, 0, 0], material = "painted_steel" }
	{ shape = "mesh", files = ["poisson_384000.mesh", "poisson_depth8_384000.mesh", "poisson_depth7.mesh", "poisson_depth6.mesh"], scale = 1, position = [-2.4, 0, 0], material = "painted_steel" }
	{ shape = "mesh", files = ["poisson_192000.mesh", "poisson_depth8_192000.mesh", "poisson_depth7.mesh", "poisson_depth6.mesh"], scale = 1, position = [-0.8, 0, 0], material = "painted_steel" }
	{ shape = "mesh", files = ["poisson_96000.mesh", "poisson_depth8_96000.mesh", "poisson_depth7_96000.mesh", "poisson_depth6.mesh"], scale = 1, position = [0.8, 0, 0], material = "painted_steel" }
	{ shape = "mesh", files = ["poisson_48000.mesh", "poisson_depth8_48000.mesh", "poisson_depth7_48000.mesh", "poisson_depth6.mesh"], scale = 1, position = [2.4, 0, 0], material = "painted_steel" }
	{ shape = "mesh", files = ["poisson_24000.mesh", "poisson_depth8_24000.mesh", "poisson_depth7_24000.mesh", "poisson_depth6_24000.mesh"], scale = 1, position = [4, 0, 0], material = "painted_steel" }
	{ shape = "mesh", files = ["poisson_12000.mesh", "poisson_depth8_12000.mesh", "poisson_depth7_12000.mesh", "poisson_depth6_12000.mesh"], scale = 1, position = [5.6, 0, 0], material = "painted_steel" }
]
labels = [
	{ text = "full, 1.46 M triangles", position = [-5.6, 1.3, 0] }
	{ text = "768000 triangles", position = [-4, 1.3, 0] }
	{ text = "384000 triangles", position = [-2.4, 1.3, 0] }
	{ text = "192000 triangles", position = [-0.8, 1.3, 0] }
	{ text = "96000 triangles", position = [0.8, 1.3, 0] }
	{ text = "48000 triangles", position = [2.4, 1.3, 0] }
	{ text = "24000 triangles", position = [4, 1.3, 0] }
	{ text = "12000 triangles", position = [5.6, 1.3, 0] }
]
